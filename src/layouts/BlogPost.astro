---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, canonicalUrl } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.title {
				margin-bottom: 1.5rem;
			}
			.title h1 {
				margin: 0.25rem 0 0;
				font-size: 2.2rem;
			}
			.date {
				color: var(--muted);
				font-size: 0.9rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.repost-note {
				margin: 0.75rem 0 0;
				font-size: 0.95rem;
				font-style: italic;
				color: var(--muted);
			}
			.hero-image {
				margin: 0 0 2rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 6px;
			}
			article :global(p) {
				margin: 0 0 1.25rem;
			}
			article :global(h2) {
				margin-top: 2rem;
			}
			/* Full-width screenshots: break standalone images out of the text
			   column to a wide centered band (capped so they stay crisp). */
			article :global(p:has(> img)),
			article > :global(img) {
				width: min(96vw, 1200px);
				max-width: 96vw;
				margin-left: calc(50% - min(48vw, 600px));
				margin-right: calc(50% - min(48vw, 600px));
				text-align: center;
			}
			article :global(p:has(> img)) > :global(img),
			article > :global(img) {
				display: block;
				width: 100% !important;
				max-width: 100% !important;
				margin: 0 auto;
				border-radius: 6px;
			}
			/* Interactive widgets (recharts charts, token/trie visualizers) were
			   built for the Sweep blog's dark theme — wrap each in a dark figure
			   card so their light text/labels stay readable on this light page. */
			/* Interactive widgets. Charts render as light cards (via the light
			   Nextra vars below); code/token panels keep their own dark
			   backgrounds. Force a sans-serif font so chart labels don't inherit
			   the page's serif. */
			article :global(astro-island) {
				display: block;
				margin: 1.75rem 0;
				overflow-x: auto;
				font-family:
					ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial,
					sans-serif;
				--nextra-bg: #ffffff;
				--nextra-fg: #1f2937;
				--nextra-border: #e5e7eb;
			}
			.back {
				display: inline-block;
				margin-bottom: 2rem;
				color: var(--muted);
				text-decoration: none;
				font-size: 0.95rem;
			}
			.back:hover {
				color: var(--ink);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a class="back" href="/blog">&larr; Writing</a>
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated-on">
									{' '}· updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					{
						canonicalUrl && (
							<p class="repost-note">
								Originally published on the{' '}
								<a href={canonicalUrl} target="_blank" rel="noopener">Sweep blog</a>.
							</p>
						)
					}
				</div>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
