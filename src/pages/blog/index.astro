---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmtDate = (d) =>
	`${d.getFullYear()} ${d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' })}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing · ${SITE_TITLE}`} description="Writing by Kevin Lu." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			<ul class="entry-list">
				{
					posts.map((post) => (
						<li>
							<span class="date">{fmtDate(post.data.pubDate)}</span>
							<span class="entry-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								{post.data.description && <span class="desc"> — {post.data.description}</span>}
							</span>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<style>
			h1 {
				margin-bottom: 1.5rem;
			}
			.entry-list li {
				margin: 0.6rem 0;
			}
			.desc {
				color: var(--muted);
			}
		</style>
	</body>
</html>
