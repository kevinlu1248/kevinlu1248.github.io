---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmtDate = (d) =>
	`${d.getFullYear()} ${d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' })}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<div class="bio">
					<p>I am the co-founder of <a href="https://sweep.dev">Sweep AI</a> (YC&nbsp;S23).</p>
					<p>We build AI agents that help software engineers write and maintain code.</p>
					<p>Previously, I was a machine learning engineer at Roblox.</p>
					<p>I studied computer science at the University of Waterloo.</p>
					<p>I write about large language models, fine-tuning, and developer tools.</p>
					<p class="links">
						<a href="https://github.com/kevinlu1248">GitHub</a> /
						<a href="https://sweep.dev">Sweep</a> /
						<a href="mailto:kevin@sweep.dev">Email</a>
					</p>
				</div>
				<img class="portrait" src="/profile.jpg" alt="Kevin Lu" width="150" height="150" />
			</section>

			{
				posts.length > 0 && (
					<section class="section">
						<h2>Writing</h2>
						<ul class="entry-list">
							{posts.map((post) => (
								<li>
									<span class="date">{fmtDate(post.data.pubDate)}</span>
									<span class="entry-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</span>
								</li>
							))}
						</ul>
					</section>
				)
			}

		</main>
		<Footer />
		<style>
			.intro {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 2rem;
			}
			.bio {
				flex: 1;
			}
			.bio p {
				margin: 0 0 0.75rem 0;
			}
			.links {
				margin-top: 1.25rem !important;
			}
			.portrait {
				flex: 0 0 auto;
				width: 150px;
				height: 150px;
				object-fit: cover;
				border-radius: 4px;
				margin-top: 0.25rem;
			}
			.section {
				margin-top: 3rem;
			}
			@media (max-width: 640px) {
				.intro {
					flex-direction: column-reverse;
					align-items: flex-start;
					gap: 1.25rem;
				}
				.portrait {
					width: 120px;
					height: 120px;
				}
			}
		</style>
	</body>
</html>
